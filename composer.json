{
    "name": "derafu/symfony-form-bundle",
    "description": "Derafu: Symfony Form Bundle - Integrates derafu/form with Symfony.",
    "type": "symfony-bundle",
    "homepage": "https://www.derafu.dev/docs/symfony/form-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/symfony-form-bundle/issues",
        "source": "https://github.com/derafu/symfony-form-bundle"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\FormBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsFormBundle\\": "tests/src/",
            "Derafu\\TestsFormBundle\\Fixture\\": "tests/fixtures/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/array": "dev-main",
        "derafu/data-processor": "*",
        "derafu/form": "*",
        "derafu/symfony-translation-bundle": "dev-main",
        "derafu/value": "dev-main",
        "symfony/asset-mapper": "^8.1",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/security-csrf": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "symfony/security-bundle": "^8.1",
        "symfony/form": "^8.1"
    },
    "suggest": {
        "symfony/security-bundle": "Required in practice so security.csrf.token_manager is available for protected Derafu forms."
    },
    "scripts": {
        "docs": "php tools/phpdocumentor run --config=phpdoc.xml",
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "phpstan-export": "vendor/bin/phpstan analyse --configuration=phpstan.neon --level 9 --generate-baseline",
        "build": "npm run build"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
